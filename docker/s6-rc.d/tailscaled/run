#!/command/with-contenv sh
# shellcheck shell=sh
# Tailscale userspace networking (no TUN / NET_ADMIN) for Railway and similar hosts.
# Inbound: tailnet → Tailscale IP:$PORT forwards to localhost:$PORT (control plane).
# Outbound to other tailnet nodes: optional TAILSCALE_OUTBOUND_PROXY (see cont-init 04).
# Subnet routes from other nodes: optional TAILSCALE_ACCEPT_ROUTES (needs outbound proxy).
#
# SSH (TAILSCALE_SSH) — Railway uses userspace networking; Tailscale SSH (--ssh) often
# accepts TCP :22 but never sends an SSH banner (client hangs after "Local version string").
# Default openssh: real sshd on loopback + `tailscale serve --tcp 22`.
#   openssh (default) — stock `ssh user@host` + /opt/data/.ssh/authorized_keys
#   tailscale         — `tailscale up --ssh` (can hang on userspace; not recommended here)
#   0                 — off
#
# HTTPS (TAILSCALE_HTTPS=1) — cert-additive Serve HTTPS on 443 → http://127.0.0.1:$PORT.
# Does NOT close plain http://<magicdns>:$PORT/ (userspace still forwards $PORT).
# Requires MagicDNS + HTTPS Certificates enabled on the tailnet (admin console).
# Certs/state live under --statedir on the volume (avoid LE rate limits on redeploy).
# Serve config is persisted node state: every boot resets and re-applies from env.

# No auth key: hold the dependency slot open without joining a tailnet.
case "${TAILSCALE_AUTH_KEY:-}" in
    "") exec sleep infinity ;;
esac

DATA_DIR="${HERMES_DATA_DIR:-/opt/data}"
TS_STATE_DIR="${TAILSCALE_STATE_DIR:-${DATA_DIR}/.tailscale}"
TS_SOCKET="${TAILSCALE_SOCKET:-/run/tailscale/tailscaled.sock}"
TS_HOSTNAME="${TAILSCALE_HOSTNAME:-${RAILWAY_SERVICE_NAME:-hermes-all-in-one}}"

# openssh | tailscale | off
TS_SSH_MODE="openssh"
case "${TAILSCALE_SSH:-openssh}" in
    0|false|FALSE|False|no|NO|No|off|OFF|Off) TS_SSH_MODE="off" ;;
    tailscale|TAILSCALE|Tailscale) TS_SSH_MODE="tailscale" ;;
    1|true|TRUE|True|yes|YES|Yes|openssh|OPENSSH|Openssh) TS_SSH_MODE="openssh" ;;
esac

# Accept subnet routes advertised by other tailnet nodes (e.g. homelab LAN via a
# subnet router). With userspace networking there is no kernel route table; the
# SOCKS/HTTP proxy only dials those prefixes when RouteAll is enabled — pair with
# TAILSCALE_OUTBOUND_PROXY=1 so Hermes traffic goes through localhost:1055.
TS_ACCEPT_ROUTES=0
case "${TAILSCALE_ACCEPT_ROUTES:-}" in
    1|true|TRUE|True|yes|YES|Yes) TS_ACCEPT_ROUTES=1 ;;
esac

# Cert-additive HTTPS via `tailscale serve --https=443` (not a tailscale up flag).
TS_HTTPS=0
case "${TAILSCALE_HTTPS:-}" in
    1|true|TRUE|True|yes|YES|Yes) TS_HTTPS=1 ;;
esac

mkdir -p /run/tailscale "${TS_STATE_DIR}" "${TS_STATE_DIR}/profile"

# Do not route tailscaled's own control-plane traffic through ALL_PROXY (set by
# cont-init 04 for app services). That causes startup races and spurious errors.
unset ALL_PROXY HTTP_PROXY HTTPS_PROXY http_proxy https_proxy all_proxy

export TS_LOCAL_APP_DATA="${TS_STATE_DIR}/profile"

# PMTU black-hole workaround for restrictive client paths (office NAT, PPPoE,
# stacked VPNs). Railway has no NET_ADMIN, so iptables MSS clamp is unavailable;
# TS_DEBUG_MTU is the server-side knob tailscaled reads at startup.
case "${TAILSCALE_MTU:-1200}" in
    0|false|FALSE|off|OFF|disable|DISABLE)
        ;;
    *)
        export TS_DEBUG_MTU="${TAILSCALE_MTU:-1200}"
        echo "[tailscaled] TS_DEBUG_MTU=${TS_DEBUG_MTU} (PMTU workaround; TAILSCALE_MTU=0 to disable)" >&2
        ;;
esac

echo "[tailscaled] starting userspace tailscaled (statedir=${TS_STATE_DIR} ssh=${TS_SSH_MODE} https=${TS_HTTPS} accept-routes=${TS_ACCEPT_ROUTES})" >&2

# Keep --state for existing volumes; add --statedir so TLS certs land on the
# volume (…/certs), not ephemeral /var/lib/tailscale/certs.
tailscaled \
    --tun=userspace-networking \
    --socks5-server=localhost:1055 \
    --outbound-http-proxy-listen=localhost:1055 \
    --statedir="${TS_STATE_DIR}" \
    --state="${TS_STATE_DIR}/tailscaled.state" \
    --socket="${TS_SOCKET}" &

TPID=$!

_ts_up() {
    set -- \
        --auth-key="${TAILSCALE_AUTH_KEY}" \
        --hostname="${TS_HOSTNAME}" \
        --accept-dns=false
    if [ "${TS_ACCEPT_ROUTES}" = "1" ]; then
        set -- "$@" --accept-routes
    fi
    if [ "${TS_SSH_MODE}" = "tailscale" ]; then
        set -- "$@" --ssh
    fi
    tailscale --socket="${TS_SOCKET}" up "$@"
}

_ts_alive() {
    kill -0 "${TPID}" 2>/dev/null
}

attempt=0
while ! _ts_up; do
    attempt=$((attempt + 1))
    if ! _ts_alive; then
        # Real crash: let s6 respawn. Do not exit on auth/control-plane lag —
        # killing a warm tailscaled manufactures the healthwatch crash-loop.
        echo "[tailscaled] error: tailscaled exited before joining tailnet (pid=${TPID})" >&2
        wait "${TPID}" || true
        exit 1
    fi
    # Log every 10 tries so a slow join is visible in Railway logs (no attempt cap).
    if [ $((attempt % 10)) -eq 0 ]; then
        echo "[tailscaled] still waiting for tailscale up (attempt ${attempt})" >&2
    fi
    sleep 0.5
done

if [ "${TS_SSH_MODE}" = "tailscale" ]; then
    tailscale --socket="${TS_SOCKET}" set --ssh 2>/dev/null || true
elif [ "${TS_SSH_MODE}" = "openssh" ]; then
    if command -v sshd >/dev/null 2>&1; then
        mkdir -p /run/sshd
        # Host keys are created once under ${DATA_DIR}/.ssh/host by cont-init 06
        # (volume-persisted). Do not run ssh-keygen -A — that regenerates ephemeral
        # /etc/ssh keys and triggers "REMOTE HOST IDENTIFICATION HAS CHANGED".
        HOST_DIR="${DATA_DIR}/.ssh/host"
        if [ ! -f "${HOST_DIR}/ssh_host_ed25519_key" ]; then
            echo "[tailscaled] warning: missing host keys in ${HOST_DIR}; generating now" >&2
            mkdir -p "${HOST_DIR}"
            ssh-keygen -t ed25519 -f "${HOST_DIR}/ssh_host_ed25519_key" -N "" -C "hermes-all-in-one" 2>/dev/null || true
            ssh-keygen -t ecdsa -f "${HOST_DIR}/ssh_host_ecdsa_key" -N "" -C "hermes-all-in-one" 2>/dev/null || true
            ssh-keygen -t rsa -b 4096 -f "${HOST_DIR}/ssh_host_rsa_key" -N "" -C "hermes-all-in-one" 2>/dev/null || true
            chown root:root "${HOST_DIR}" "${HOST_DIR}"/ssh_host_*_key "${HOST_DIR}"/ssh_host_*_key.pub 2>/dev/null || true
            chmod 700 "${HOST_DIR}"
            chmod 600 "${HOST_DIR}"/ssh_host_*_key 2>/dev/null || true
            chmod 644 "${HOST_DIR}"/ssh_host_*_key.pub 2>/dev/null || true
        fi
        /usr/sbin/sshd -e 2>/dev/null &
        sleep 0.5
    else
        echo "[tailscaled] warning: openssh-server not installed; set TAILSCALE_SSH=tailscale or rebuild image" >&2
        TS_SSH_MODE="off"
    fi
fi

# Serve config is persisted node state. Reset once, then re-apply every handler
# from current env so toggling TAILSCALE_HTTPS/SSH off actually clears them.
# Must run outside the SSH-mode branch (HTTPS-only and SSH-off still need reset).
# Retry apply: after reset, a transient serve failure would drop SSH with no fallback.
_ts_serve() {
    _ts_serve_n=0
    _ts_serve_err=""
    while [ "${_ts_serve_n}" -lt 3 ]; do
        if _ts_serve_err="$(tailscale --socket="${TS_SOCKET}" serve "$@" 2>&1)"; then
            return 0
        fi
        _ts_serve_n=$((_ts_serve_n + 1))
        sleep 1
    done
    echo "[tailscaled] serve $* failed: ${_ts_serve_err}" >&2
    return 1
}

if ! _ts_serve_err="$(tailscale --socket="${TS_SOCKET}" serve reset 2>&1)"; then
    echo "[tailscaled] warning: tailscale serve reset failed: ${_ts_serve_err}" >&2
fi

if [ "${TS_SSH_MODE}" = "openssh" ]; then
    if _ts_serve --bg --tcp 22 127.0.0.1:22; then
        echo "[tailscaled] openssh on 127.0.0.1:22 via tailscale serve (keys=${DATA_DIR}/.ssh/authorized_keys hostkeys=${DATA_DIR}/.ssh/host)" >&2
    else
        echo "[tailscaled] warning: tailscale serve for SSH failed after retries" >&2
    fi
fi

if [ "${TS_HTTPS}" = "1" ]; then
    TS_HTTPS_TARGET="http://127.0.0.1:${PORT:-8787}"
    # Modern CLI: serve --bg --https=443 <target> (legacy "serve https / <target>" is gone).
    if _ts_serve --bg --https=443 "${TS_HTTPS_TARGET}"; then
        echo "[tailscaled] https://<magicdns>/ → ${TS_HTTPS_TARGET} (certs under ${TS_STATE_DIR}/certs; plain http://<magicdns>:\$PORT still open)" >&2
    else
        echo "[tailscaled] warning: HTTPS serve failed after retries (enable MagicDNS + HTTPS Certificates in admin console if unset)" >&2
    fi
fi

echo "[tailscaled] joined tailnet as ${TS_HOSTNAME} (ssh=${TS_SSH_MODE} https=${TS_HTTPS})" >&2
if [ "${TS_SSH_MODE}" = "tailscale" ]; then
    echo "[tailscaled] warning: Tailscale SSH often hangs on userspace (no remote SSH banner); prefer TAILSCALE_SSH=openssh" >&2
fi

wait "${TPID}"
